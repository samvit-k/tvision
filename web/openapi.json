{
  "openapi": "3.1.0",
  "info": {
    "title": "TVision",
    "description": "Research-use tumor-nucleus detection in H&E images. Not a clinical diagnostic tool.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/model": {
      "get": {
        "summary": "Model",
        "operationId": "model_model_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceInfo"
                }
              }
            }
          }
        }
      }
    },
    "/detect": {
      "post": {
        "summary": "Detect",
        "operationId": "detect_detect_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_detect_detect_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetectionResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_detect_detect_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "conf": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conf"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_detect_detect_post"
      },
      "Box": {
        "properties": {
          "x1": {
            "type": "number",
            "minimum": 0.0,
            "title": "X1"
          },
          "y1": {
            "type": "number",
            "minimum": 0.0,
            "title": "Y1"
          },
          "x2": {
            "type": "number",
            "title": "X2"
          },
          "y2": {
            "type": "number",
            "title": "Y2"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "x1",
          "y1",
          "x2",
          "y2"
        ],
        "title": "Box"
      },
      "Detection": {
        "properties": {
          "class_id": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Class Id"
          },
          "class_name": {
            "type": "string",
            "title": "Class Name"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Confidence"
          },
          "box": {
            "$ref": "#/components/schemas/Box"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "class_id",
          "class_name",
          "confidence",
          "box"
        ],
        "title": "Detection"
      },
      "DetectionResult": {
        "properties": {
          "image": {
            "$ref": "#/components/schemas/ImageInfo"
          },
          "model": {
            "$ref": "#/components/schemas/ModelInfo"
          },
          "threshold": {
            "type": "number",
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Threshold"
          },
          "detections": {
            "items": {
              "$ref": "#/components/schemas/Detection"
            },
            "type": "array",
            "title": "Detections"
          },
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Counts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "image",
          "model",
          "threshold",
          "detections",
          "counts"
        ],
        "title": "DetectionResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImageInfo": {
        "properties": {
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Height"
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Scale",
            "description": "Model input size / image long side: the resize applied before inference"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "width",
          "height",
          "scale"
        ],
        "title": "ImageInfo"
      },
      "InputLimits": {
        "properties": {
          "min_long_side": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Min Long Side"
          },
          "max_long_side": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Max Long Side"
          },
          "min_threshold": {
            "type": "number",
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Min Threshold"
          },
          "max_upload_bytes": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Max Upload Bytes"
          },
          "content_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Content Types"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "min_long_side",
          "max_long_side",
          "min_threshold",
          "max_upload_bytes",
          "content_types"
        ],
        "title": "InputLimits"
      },
      "ModelInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "weights_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Weights Sha256"
          },
          "imgsz": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Imgsz"
          },
          "max_det": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Max Det"
          },
          "iou": {
            "type": "number",
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Iou"
          },
          "classes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Classes"
          },
          "headline_classes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Headline Classes"
          },
          "default_threshold": {
            "type": "number",
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Default Threshold"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "weights_sha256",
          "imgsz",
          "max_det",
          "iou",
          "classes",
          "headline_classes",
          "default_threshold"
        ],
        "title": "ModelInfo"
      },
      "ServiceInfo": {
        "properties": {
          "model": {
            "$ref": "#/components/schemas/ModelInfo"
          },
          "limits": {
            "$ref": "#/components/schemas/InputLimits"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model",
          "limits"
        ],
        "title": "ServiceInfo",
        "description": "What `GET /model` returns: the served model and the limits `POST /detect` enforces."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}