{
  "name": "tvision-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "gen:openapi": "uv run --project .. python -c \"import json, sys; from tvision.api import create_app; sys.stdout.write(json.dumps(create_app().openapi(), indent=2))\" > openapi.json",
    "gen:types": "openapi-typescript openapi.json -o app/types/api.ts",
    "typecheck": "nuxt typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "5.3.0",
    "lucide-vue-next": "1.0.0",
    "nuxt": "4.6.1",
    "vue": "3.5.43",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.13"
  }
}